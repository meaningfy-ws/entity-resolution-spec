        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty dcatap_linkml:type ],
        [ a owl:Restriction ;
            owl:allValuesFrom dcatap_linkml:Location ;
            owl:onProperty dcatap_linkml:geographical_coverage ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty dcatap_linkml:related_resource ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty dcatap_linkml:landing_page ],
        [ a owl:Restriction ;
            owl:allValuesFrom dcatap_linkml:Resource ;
            owl:onProperty dcatap_linkml:related_resource ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty dcatap_linkml:access_rights ],
        [ a owl:Restriction ;
            owl:allValuesFrom dcatap_linkml:Document ;
            owl:onProperty dcatap_linkml:landing_page ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty dcatap_linkml:title ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty dcatap_linkml:publisher ],
        [ a owl:Restriction ;
            owl:allValuesFrom dcatap_linkml:LinguisticSystem ;
            owl:onProperty dcatap_linkml:language ],
        [ a owl:Restriction ;
            owl:allValuesFrom dcatap_linkml:Relationship ;
            owl:onProperty dcatap_linkml:qualified_relation ],
        [ a owl:Restriction ;
            owl:allValuesFrom dcatap_linkml:Document ;
            owl:onProperty dcatap_linkml:documentation ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty dcatap_linkml:source ],
        [ a owl:Restriction ;
            owl:allValuesFrom dcatap_linkml:Resource ;
            owl:onProperty dcatap_linkml:is_referenced_by ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:date ;
            owl:onProperty dcatap_linkml:modification_date ],
        [ a owl:Restriction ;
            owl:allValuesFrom dcatap_linkml:Distribution ;
            owl:onProperty dcatap_linkml:dataset_distribution ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:decimal ;
            owl:onProperty dcatap_linkml:spatial_resolution ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty dcatap_linkml:description ],
        [ a owl:Restriction ;
            owl:allValuesFrom dcatap_linkml:Attribution ;
            owl:onProperty dcatap_linkml:qualified_attribution ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty dcatap_linkml:temporal_resolution ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty dcatap_linkml:frequency ],
        [ a owl:Restriction ;
            owl:allValuesFrom dcatap_linkml:Concept ;
            owl:onProperty dcatap_linkml:theme ],
        [ a owl:Restriction ;
            owl:allValuesFrom dcatap_linkml:PeriodOfTime ;
            owl:onProperty dcatap_linkml:temporal_coverage ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty dcatap_linkml:version ] ;
    skos:definition "See [DCAT-AP specs:Dataset](https://semiceu.github.io/DCAT-AP/releases/3.0.0/#Dataset)" ;
    skos:exactMatch dcat:Dataset ;
    skos:inScheme <https://w3id.org/nfdi-de/dcat-ap-linkml> .

