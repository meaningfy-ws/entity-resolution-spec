@prefix adms: <http://www.w3.org/ns/adms#> .
@prefix dcat: <http://www.w3.org/ns/dcat#> .
@prefix dcatap_linkml: <https://w3id.org/nfdi-de/dcat-ap-linkml/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix eli: <http://data.europa.eu/eli/ontology#> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix iana: <https://www.iana.org/assignments/> .
@prefix linkml: <https://w3id.org/linkml/> .
@prefix locn: <http://www.w3.org/ns/locn#> .
@prefix odrl: <http://www.w3.org/ns/odrl/2/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix spdx: <http://spdx.org/rdf/terms#> .
@prefix time: <http://www.w3.org/2006/time#> .
@prefix vcard: <http://www.w3.org/2006/vcard/ns#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://w3id.org/nfdi-de/dcat-ap-linkml.owl.ttl> a owl:Ontology ;
    rdfs:label "dcat-ap-linkml" ;
    dcterms:license "CC-BY 4.0" ;
    dcterms:source <https://semiceu.github.io/DCAT-AP/releases/3.0.0> ;
    dcterms:title "LinkML schema representation of DCAT-AP 3.0.0" ;
    skos:definition """This LinkML schema representation of DCAT-AP 3.0.0 was automatically created from these [JSON-LD SHACL shapes](https://github.com/SEMICeu/DCAT-AP/blob/master/releases/3.0.0/shacl/dcat-ap-SHACL.jsonld) using this Python script: https://github.com/StroemPhi/dcat-4C-ap/tree/main/src/dcat-ap_shacl_2_linkml.py.
NOTE:The JSON-LD SHACL constraints published with the [July 3.0.0 GitHub release](https://github.com/SEMICeu/DCAT-AP/releases/tag/3.0.0) and in the [3.0.0. release branch](https://github.com/SEMICeu/DCAT-AP/tree/3.0.0) are different from the ones in https://github.com/SEMICeu/DCAT-AP/tree/master/releases/3.0.0. Also the TTL shapes provided in the latter in the HTML folder differ from the ones in the SHACL folder, in that they declare "dcat:ResourceShape/DcatResource_Shape" and "TemporalLiteralShape/DateOrDateTimeDataType_Shape"(shacl/html folder) as unions of the dcat:Dataset, dcat:Catalog, dcat:DataService and dcat:DatasetSeries respectively the datatypes xsd:date, xsd:dateTime, xsd:gYear & xsd:gYearMonth. We currently address this in the conversion script by only allowing xsd:date as a [Temporal Literal](https://semiceu.github.io/DCAT-AP/releases/3.0.0/#TemporalLiteral), which means that this LinkML representation of DCAT-AP is stricter and values in xsd:dateTime format will automatically be typecast to xsd:date. Regarding the 'dcat:ResourceShape/DcatResource_Shape' we use the LinkML [union as ranges](https://linkml.io/linkml/schemas/advanced.html#unions-as-ranges) approach to provide the expected union of dcat:Resource subclasses. However, this is not fully implemented in LinkML yet, so that any kind of object/class could be used, until https://github.com/linkml/linkml/issues/1813 is fixed.""" .

xsd:hexBinary a rdfs:Datatype ;
    owl:equivalentClass [ a rdfs:Datatype ;
            owl:onDatatype xsd:string ;
            owl:withRestrictions ( [ xsd:pattern "([0-9a-fA-F]{2})*" ] ) ] .

xsd:nonNegativeInteger a rdfs:Datatype ;
    owl:equivalentClass [ a rdfs:Datatype ;
            owl:onDatatype xsd:string ;
            owl:withRestrictions ( [ xsd:pattern "([\\-+]?[0-9]+)" ] ) ] .

dcatap_linkml:Activity a owl:Class ;
    rdfs:label "Activity" ;
    skos:definition "See [DCAT-AP specs:Activity](https://semiceu.github.io/DCAT-AP/releases/3.0.0/#Activity)" ;
    skos:exactMatch prov:Activity ;
    skos:inScheme <https://w3id.org/nfdi-de/dcat-ap-linkml> .

dcatap_linkml:Any a owl:Class ;
    rdfs:label "Any" ;
    skos:definition "This abstract class is needed to create the union of Dataset, DatasetSeries, Catalogue and DataService for the range of the slot [primary_topic](https://nfdi-de.github.io/chem-dcat-ap/elements/primary_topic/)." ;
    skos:exactMatch linkml:Any ;
    skos:inScheme <https://w3id.org/nfdi-de/dcat-ap-linkml> .

dcatap_linkml:Attribution a owl:Class ;
    rdfs:label "Attribution" ;
    rdfs:subClassOf dcatap_linkml:SupportiveEntity ;
    skos:definition "See [DCAT-AP specs:Attribution](https://semiceu.github.io/DCAT-AP/releases/3.0.0/#Attribution)" ;
    skos:exactMatch prov:Attribution ;
    skos:inScheme <https://w3id.org/nfdi-de/dcat-ap-linkml> .

dcatap_linkml:Checksum a owl:Class ;
    rdfs:label "Checksum" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty dcatap_linkml:algorithm ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty dcatap_linkml:checksum_value ],
        [ a owl:Restriction ;
            owl:allValuesFrom dcatap_linkml:ChecksumAlgorithm ;
            owl:onProperty dcatap_linkml:algorithm ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty dcatap_linkml:checksum_value ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:hexBinary ;
            owl:onProperty dcatap_linkml:checksum_value ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty dcatap_linkml:algorithm ] ;
    skos:definition "See [DCAT-AP specs:Checksum](https://semiceu.github.io/DCAT-AP/releases/3.0.0/#Checksum)" ;
    skos:exactMatch spdx:Checksum ;
    skos:inScheme <https://w3id.org/nfdi-de/dcat-ap-linkml> .

dcatap_linkml:ChecksumAlgorithm a owl:Class ;
    rdfs:label "ChecksumAlgorithm" ;
    rdfs:subClassOf dcatap_linkml:SupportiveEntity ;
    skos:definition "See [DCAT-AP specs:ChecksumAlgorithm](https://semiceu.github.io/DCAT-AP/releases/3.0.0/#ChecksumAlgorithm)" ;
    skos:exactMatch spdx:ChecksumAlgorithm ;
    skos:inScheme <https://w3id.org/nfdi-de/dcat-ap-linkml> .

dcatap_linkml:ConceptScheme a owl:Class ;
    rdfs:label "ConceptScheme" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty dcatap_linkml:title ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty dcatap_linkml:title ],
        dcatap_linkml:SupportiveEntity ;
    skos:definition "See [DCAT-AP specs:ConceptScheme](https://semiceu.github.io/DCAT-AP/releases/3.0.0/#ConceptScheme)" ;
    skos:exactMatch skos:ConceptScheme ;
    skos:inScheme <https://w3id.org/nfdi-de/dcat-ap-linkml> .

dcatap_linkml:Geometry a owl:Class ;
    rdfs:label "Geometry" ;
    rdfs:subClassOf dcatap_linkml:SupportiveEntity ;
    skos:definition "See [DCAT-AP specs:Geometry](https://semiceu.github.io/DCAT-AP/releases/3.0.0/#Geometry)" ;
    skos:exactMatch locn:Geometry ;
    skos:inScheme <https://w3id.org/nfdi-de/dcat-ap-linkml> .

dcatap_linkml:Identifier a owl:Class ;
    rdfs:label "Identifier" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty dcatap_linkml:notation ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty dcatap_linkml:notation ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty dcatap_linkml:notation ],
        dcatap_linkml:SupportiveEntity ;
    skos:definition "See [DCAT-AP specs:Identifier](https://semiceu.github.io/DCAT-AP/releases/3.0.0/#Identifier)" ;
    skos:exactMatch adms:Identifier ;
    skos:inScheme <https://w3id.org/nfdi-de/dcat-ap-linkml> .

dcatap_linkml:Policy a owl:Class ;
    rdfs:label "Policy" ;
    rdfs:subClassOf dcatap_linkml:SupportiveEntity ;
    skos:definition "See [DCAT-AP specs:Policy](https://semiceu.github.io/DCAT-AP/releases/3.0.0/#Policy)" ;
    skos:exactMatch odrl:Policy ;
    skos:inScheme <https://w3id.org/nfdi-de/dcat-ap-linkml> .

dcatap_linkml:ProvenanceStatement a owl:Class ;
    rdfs:label "ProvenanceStatement" ;
    rdfs:subClassOf dcatap_linkml:SupportiveEntity ;
    skos:definition "See [DCAT-AP specs:ProvenanceStatement](https://semiceu.github.io/DCAT-AP/releases/3.0.0/#ProvenanceStatement)" ;
    skos:exactMatch dcterms:ProvenanceStatement ;
    skos:inScheme <https://w3id.org/nfdi-de/dcat-ap-linkml> .

dcatap_linkml:Relationship a owl:Class ;
    rdfs:label "Relationship" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty dcatap_linkml:had_role ],
        [ a owl:Restriction ;
            owl:allValuesFrom dcatap_linkml:Resource ;
            owl:onProperty dcatap_linkml:relation ],
        [ a owl:Restriction ;
            owl:allValuesFrom dcatap_linkml:Role ;
            owl:onProperty dcatap_linkml:had_role ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty dcatap_linkml:relation ] ;
    skos:definition "See [DCAT-AP specs:Relationship](https://semiceu.github.io/DCAT-AP/releases/3.0.0/#Relationship)" ;
    skos:exactMatch dcat:Relationship ;
    skos:inScheme <https://w3id.org/nfdi-de/dcat-ap-linkml> .

dcatap_linkml:Role a owl:Class ;
    rdfs:label "Role" ;
    rdfs:subClassOf dcatap_linkml:SupportiveEntity ;
    skos:definition "See [DCAT-AP specs:Role](https://semiceu.github.io/DCAT-AP/releases/3.0.0/#Role)" ;
    skos:exactMatch dcat:Role ;
    skos:inScheme <https://w3id.org/nfdi-de/dcat-ap-linkml> .

<http://publications.europa.eu/resource/authority/data-theme/AGRI> a owl:Class ;
    rdfs:label "AGRI" ;
    rdfs:subClassOf <http://publications.europa.eu/resource/authority/data-theme> ;
    skos:definition "Agriculture, fisheries, forestry and food" .

<http://publications.europa.eu/resource/authority/data-theme/ECON> a owl:Class ;
    rdfs:label "ECON" ;
    rdfs:subClassOf <http://publications.europa.eu/resource/authority/data-theme> ;
    skos:definition "Economy and finance" .

<http://publications.europa.eu/resource/authority/data-theme/EDUC> a owl:Class ;
    rdfs:label "EDUC" ;
    rdfs:subClassOf <http://publications.europa.eu/resource/authority/data-theme> ;
    skos:definition "Education, culture and sport" .

<http://publications.europa.eu/resource/authority/data-theme/ENER> a owl:Class ;
    rdfs:label "ENER" ;
    rdfs:subClassOf <http://publications.europa.eu/resource/authority/data-theme> ;
    skos:definition "Energy" .

<http://publications.europa.eu/resource/authority/data-theme/ENVI> a owl:Class ;
    rdfs:label "ENVI" ;
    rdfs:subClassOf <http://publications.europa.eu/resource/authority/data-theme> ;
    skos:definition "Environment" .

<http://publications.europa.eu/resource/authority/data-theme/GOVE> a owl:Class ;
    rdfs:label "GOVE" ;
    rdfs:subClassOf <http://publications.europa.eu/resource/authority/data-theme> ;
    skos:definition "Government and public sector" .

<http://publications.europa.eu/resource/authority/data-theme/HEAL> a owl:Class ;
    rdfs:label "HEAL" ;
    rdfs:subClassOf <http://publications.europa.eu/resource/authority/data-theme> ;
    skos:definition "Health" .

<http://publications.europa.eu/resource/authority/data-theme/INTR> a owl:Class ;
    rdfs:label "INTR" ;
    rdfs:subClassOf <http://publications.europa.eu/resource/authority/data-theme> ;
    skos:definition "International issues" .

<http://publications.europa.eu/resource/authority/data-theme/JUST> a owl:Class ;
    rdfs:label "JUST" ;
    rdfs:subClassOf <http://publications.europa.eu/resource/authority/data-theme> ;
    skos:definition "Justice, legal system and public safety" .

<http://publications.europa.eu/resource/authority/data-theme/OP_DATPRO> a owl:Class ;
    rdfs:label "OP_DATPRO" ;
    rdfs:subClassOf <http://publications.europa.eu/resource/authority/data-theme> ;
    skos:definition "Provisional data" .

<http://publications.europa.eu/resource/authority/data-theme/REGI> a owl:Class ;
    rdfs:label "REGI" ;
    rdfs:subClassOf <http://publications.europa.eu/resource/authority/data-theme> ;
    skos:definition "Regions and cities" .

<http://publications.europa.eu/resource/authority/data-theme/SOCI> a owl:Class ;
    rdfs:label "SOCI" ;
    rdfs:subClassOf <http://publications.europa.eu/resource/authority/data-theme> ;
    skos:definition "Population and society" .

<http://publications.europa.eu/resource/authority/data-theme/TECH> a owl:Class ;
    rdfs:label "TECH" ;
    rdfs:subClassOf <http://publications.europa.eu/resource/authority/data-theme> ;
    skos:definition "Science and technology" .

<http://publications.europa.eu/resource/authority/data-theme/TRAN> a owl:Class ;
    rdfs:label "TRAN" ;
    rdfs:subClassOf <http://publications.europa.eu/resource/authority/data-theme> ;
    skos:definition "Transport" .

xsd:duration a rdfs:Datatype ;
    owl:equivalentClass [ a rdfs:Datatype ;
            owl:onDatatype xsd:string ;
            owl:withRestrictions ( [ xsd:pattern "-?P((([0-9]+Y([0-9]+M)?([0-9]+D)?|([0-9]+M)([0-9]+D)?|([0-9]+D))(T(([0-9]+H)([0-9]+M)?([0-9]+(\\.[0-9]+)?S)?|([0-9]+M)([0-9]+(\\.[0-9]+)?S)?|([0-9]+(\\.[0-9]+)?S)))?)|(T(([0-9]+H)([0-9]+M)?([0-9]+(\\.[0-9]+)?S)?|([0-9]+M)([0-9]+(\\.[0-9]+)?S)?|([0-9]+(\\.[0-9]+)?S))))" ] ) ] .

dcatap_linkml:CatalogueRecord a owl:Class ;
    rdfs:label "CatalogueRecord" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom xsd:date ;
            owl:onProperty dcatap_linkml:modification_date ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty dcatap_linkml:change_type ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty dcatap_linkml:description ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:date ;
            owl:onProperty dcatap_linkml:listing_date ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty dcatap_linkml:modification_date ],
        [ a owl:Restriction ;
            owl:allValuesFrom dcatap_linkml:Standard ;
            owl:onProperty dcatap_linkml:application_profile ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty dcatap_linkml:description ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty dcatap_linkml:change_type ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty dcatap_linkml:title ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty dcatap_linkml:primary_topic ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty dcatap_linkml:title ],
        [ a owl:Restriction ;
            owl:allValuesFrom dcatap_linkml:CatalogueRecord ;
            owl:onProperty dcatap_linkml:source_metadata ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ owl:intersectionOf ( [ owl:unionOf ( dcatap_linkml:Catalogue dcatap_linkml:Dataset dcatap_linkml:DatasetSeries dcatap_linkml:DataService ) ] dcatap_linkml:Any ) ] ;
            owl:onProperty dcatap_linkml:primary_topic ],
        [ a owl:Restriction ;
            owl:allValuesFrom dcatap_linkml:LinguisticSystem ;
            owl:onProperty dcatap_linkml:language ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty dcatap_linkml:listing_date ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty dcatap_linkml:source_metadata ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty dcatap_linkml:language ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty dcatap_linkml:listing_date ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty dcatap_linkml:source_metadata ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty dcatap_linkml:modification_date ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty dcatap_linkml:application_profile ],
        [ a owl:Restriction ;
            owl:allValuesFrom dcatap_linkml:Concept ;
            owl:onProperty dcatap_linkml:change_type ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty dcatap_linkml:primary_topic ] ;
    skos:definition "See [DCAT-AP specs:CatalogueRecord](https://semiceu.github.io/DCAT-AP/releases/3.0.0/#CatalogueRecord)" ;
    skos:exactMatch dcat:CatalogRecord ;
    skos:inScheme <https://w3id.org/nfdi-de/dcat-ap-linkml> .

dcatap_linkml:DatasetSeries a owl:Class ;
    rdfs:label "DatasetSeries" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty dcatap_linkml:title ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty dcatap_linkml:release_date ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty dcatap_linkml:geographical_coverage ],
        [ a owl:Restriction ;
            owl:allValuesFrom dcatap_linkml:Location ;
            owl:onProperty dcatap_linkml:geographical_coverage ],
        [ a owl:Restriction ;
            owl:allValuesFrom dcatap_linkml:Agent ;
            owl:onProperty dcatap_linkml:publisher ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty dcatap_linkml:modification_date ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty dcatap_linkml:contact_point ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty dcatap_linkml:description ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty dcatap_linkml:description ],
        [ a owl:Restriction ;
            owl:allValuesFrom dcatap_linkml:PeriodOfTime ;
            owl:onProperty dcatap_linkml:temporal_coverage ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty dcatap_linkml:title ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:date ;
            owl:onProperty dcatap_linkml:release_date ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty dcatap_linkml:publisher ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty dcatap_linkml:publisher ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:date ;
            owl:onProperty dcatap_linkml:modification_date ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty dcatap_linkml:frequency ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty dcatap_linkml:release_date ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty dcatap_linkml:applicable_legislation ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty dcatap_linkml:frequency ],
        [ a owl:Restriction ;
            owl:allValuesFrom dcatap_linkml:Kind ;
            owl:onProperty dcatap_linkml:contact_point ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty dcatap_linkml:temporal_coverage ],
        [ a owl:Restriction ;
            owl:allValuesFrom dcatap_linkml:Frequency ;
            owl:onProperty dcatap_linkml:frequency ],
        [ a owl:Restriction ;
            owl:allValuesFrom dcatap_linkml:LegalResource ;
            owl:onProperty dcatap_linkml:applicable_legislation ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty dcatap_linkml:modification_date ] ;
    skos:definition "See [DCAT-AP specs:DatasetSeries](https://semiceu.github.io/DCAT-AP/releases/3.0.0/#DatasetSeries)" ;
    skos:exactMatch dcat:DatasetSeries ;
    skos:inScheme <https://w3id.org/nfdi-de/dcat-ap-linkml> .

dcatap_linkml:Distribution a owl:Class ;
    rdfs:label "Distribution" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty dcatap_linkml:access_URL ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty dcatap_linkml:media_type ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty dcatap_linkml:availability ],
        [ a owl:Restriction ;
            owl:allValuesFrom dcatap_linkml:LicenseDocument ;
            owl:onProperty dcatap_linkml:licence ],
        [ a owl:Restriction ;
            owl:allValuesFrom dcatap_linkml:RightsStatement ;
            owl:onProperty dcatap_linkml:rights ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:nonNegativeInteger ;
            owl:onProperty dcatap_linkml:byte_size ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty dcatap_linkml:byte_size ],
        [ a owl:Restriction ;
            owl:allValuesFrom dcatap_linkml:Concept ;
            owl:onProperty dcatap_linkml:availability ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:duration ;
            owl:onProperty dcatap_linkml:temporal_resolution ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty dcatap_linkml:checksum ],
        [ a owl:Restriction ;
            owl:allValuesFrom dcatap_linkml:MediaType ;
            owl:onProperty dcatap_linkml:packaging_format ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty dcatap_linkml:format ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty dcatap_linkml:status ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty dcatap_linkml:spatial_resolution ],
        [ a owl:Restriction ;
            owl:allValuesFrom dcatap_linkml:Resource ;
            owl:onProperty dcatap_linkml:download_URL ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty dcatap_linkml:rights ],
        [ a owl:Restriction ;
            owl:allValuesFrom dcatap_linkml:Resource ;
            owl:onProperty dcatap_linkml:access_URL ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty dcatap_linkml:title ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty dcatap_linkml:title ],
        [ a owl:Restriction ;
